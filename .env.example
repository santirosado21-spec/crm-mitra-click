# Fuente de datos de la app.
#   (vacío o "demo") → datos simulados, sin conexión.
#   "supabase"       → lee de Supabase. Requiere login de un usuario activo en app_users.
VITE_DATA_SOURCE=demo

# Proyecto Supabase: mitraclick-intelligence (ref drdaenkvtjjrtyjjxnrr).
# Solo llaves PÚBLICAS: la URL y la publishable key (sb_publishable_…).
# La service_role / secret key NUNCA va en variables VITE_ ni en el navegador:
# solo en el servicio de integración del lado servidor.
VITE_SUPABASE_URL=https://drdaenkvtjjrtyjjxnrr.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
