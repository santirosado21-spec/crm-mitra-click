# ── App (navegador) ──────────────────────────────────────────────────────────
# Fuente de datos:
#   (vacío o "demo") → solo datos simulados, sin conexión.
#   "supabase"       → lee de Supabase. Si no hay sesión, permisos o pedidos cargados,
#                      muestra los datos simulados con un aviso (nunca queda en blanco).
VITE_DATA_SOURCE=demo

# Proyecto Supabase: mitraclick-intelligence (ref drdaenkvtjjrtyjjxnrr).
# Solo llaves PÚBLICAS en variables VITE_: la URL y la publishable key (sb_publishable_…).
VITE_SUPABASE_URL=https://drdaenkvtjjrtyjjxnrr.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# ── Scripts de carga (solo en tu computadora, nunca en Vercel ni en el navegador) ──
# npm run data:ingest / data:seed-demo / data:purge-demo leen estas variables de .env.local.
# Llave secreta (sb_secret_…, Settings > API Keys) o el valor de INGEST_API_KEY.
# Para borrar datos (data:purge*) se necesita la llave secreta de Supabase.
MITRA_INGEST_KEY=
# Opcional: por defecto <VITE_SUPABASE_URL>/functions/v1/ingest
MITRA_INGEST_URL=
